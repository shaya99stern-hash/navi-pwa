---
import ArtifactCanvas from '../components/ArtifactCanvas.astro';
if (!import.meta.env.DEV) return new Response('Not found', {status:404});
---
<html lang="en"><head><title>Navi runtime verification</title><meta name="viewport" content="width=device-width,initial-scale=1"/></head><body><h1>Runtime verification fixtures</h1><p>These fixed examples test the renderer, not AI generation.</p><button data-kind="html">HTML counter</button><button data-kind="react">React counter</button><button data-kind="vue">Vue counter</button><button data-kind="mermaid">Mermaid diagram</button><button data-kind="latex">Math equation</button><button id="worker">Run isolated calculation</button><p id="result" role="status"></p><ArtifactCanvas/><script>
import {validateArtifact,runIsolatedJavaScript} from '../lib/sandbox/runtime';
const fixtures:Record<string,string>={html:'<button id="counter">0</button><script>document.getElementById("counter").addEventListener("click",e=>e.target.textContent=Number(e.target.textContent)+1)<\/script>',react:'export default function App(){const [count,setCount]=React.useState(0);return <button onClick={()=>setCount(count+1)}>Count {count}</button>}',vue:'export default {data(){return {count:0}},template:"<button @click=\\"count++\\">Count {{count}}</button>"}',mermaid:'graph LR\nA[Request] --> B[Validate] --> C[Artifact]',latex:'E=mc^2'};
document.querySelectorAll<HTMLButtonElement>('[data-kind]').forEach(button=>button.addEventListener('click',async()=>{try{const kind=button.dataset.kind!;const artifact=await validateArtifact({id:kind,title:button.textContent,kind,source:fixtures[kind]});window.dispatchEvent(new CustomEvent('navi:open-artifact',{detail:{artifact,versions:[artifact]}}));}catch(e){document.getElementById('result')!.textContent=String(e);}}));
document.getElementById('worker')!.addEventListener('click',()=>{void runIsolatedJavaScript('return 6 * 7').then(result=>{document.getElementById('result')!.textContent='Worker result: '+result;}).catch(e=>{document.getElementById('result')!.textContent=String(e);});});
</script><style is:global>@import '../styles/app.css';body{overflow:auto;padding:20px}body>button{border:1px solid #555;padding:10px;margin:5px}.artifact-workspace{position:fixed;inset:150px 0 0;width:100%}</style></body></html>

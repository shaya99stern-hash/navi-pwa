GEMINI_API_KEY=
GROQ_API_KEY=
HF_TOKEN=

# Optional provider and direct-route overrides
GEMINI_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GROQ_REASONING_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_TOOL_MODEL=groq/compound
HF_IMAGE_MODEL=stabilityai/stable-diffusion-3-medium-diffusers

# Hugging Face adaptive model catalog
HF_ROUTING_POLICY=
HF_SOL_ROUTING_POLICY=fastest
HF_FABLE_ROUTING_POLICY=preferred
HF_SOL_MODELS=
HF_FABLE_MODELS=
HF_MODEL_CATALOG_TTL_MS=900000

# Actual concurrent model calls remain bounded even when the live catalog contains hundreds of models
NAVI_SOL_MAX_COUNCILS=10
NAVI_FABLE_MAX_COUNCILS=8

NAVI_DEFAULT_MODEL_PRESET=auto
NAVI_ENCRYPTION_KEY=
MCP_SERVER_REGISTRY_JSON=[]

# Provider credentials. At least one is required for NaviSol to answer.
GEMINI_API_KEY=
GROQ_API_KEY=
HF_TOKEN=

# Optional free tiers. Each joins the routing pool automatically when present.
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# Web search. Either of these makes Research mode able to actually search.
# Neither is needed to *read* the web: fetch_url is always available and needs
# no key, so an install without these can still open any URL it is given.
EXA_API_KEY=
TAVILY_API_KEY=

# Premium speech for voice mode. Optional: without these the app speaks with
# the browser's own on-device voice, which is free, instant, and works offline.
#
# Metered by characters against the same durable ledger the model spend uses,
# with a hard server-side stop — a hands-free loop generates speech without
# anyone pressing send, so an unguarded key bills for as long as the tab is
# open. NAVI_TTS_MONTHLY_CHARS defaults to 10000, which is the vendor's free
# tier; raise it deliberately. Zero switches premium speech off entirely.
# Every refusal falls back to the on-device voice rather than going silent.
ELEVENLABS_API_KEY=
NAVI_TTS_VOICE_ID=
NAVI_TTS_MONTHLY_CHARS=

# Optional voice shaping. Defaults are tuned calm rather than brisk: steady
# delivery, low theatricality, speaker boost off.
NAVI_TTS_MODEL=
NAVI_TTS_STABILITY=
NAVI_TTS_SIMILARITY=
NAVI_TTS_STYLE=
NAVI_TTS_SPEAKER_BOOST=

# Cloud memory: remembered facts, learned skills, and the chat mirror. Without
# these, memory is off — the tools are never registered and Navi Soul is not
# even told it has a memory, which reads as "it does not learn".
#
# Three things are required and only two of them are here. Also apply the
# migrations in supabase/migrations, and register Clerk as a third-party auth
# provider in the Supabase project. Every RLS policy compares user_id against
# auth.jwt() ->> 'sub'; if Supabase does not trust Clerk's token that is null,
# and every read and write is refused while looking exactly like a missing
# table. /api/system/diagnostics tells the three apart.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Repository and deployment reads, install-wide.
NAVI_GITHUB_TOKEN=
NAVI_VERCEL_TOKEN=

# Per-user GitHub sign-in. With these set, each user connects their own account
# and their token is used instead of the install-wide PAT above.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Repository writes. Leave off until the read tools have been watched in
# production. Turning it on changes the requested scope from public_repo to
# repo, so every connected user must re-authorize.
NAVI_GITHUB_ALLOW_WRITES=false

# Sign-in.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

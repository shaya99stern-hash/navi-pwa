# Provider credentials. At least one is required for NaviSol to answer.
GEMINI_API_KEY=
GROQ_API_KEY=
HF_TOKEN=

# Optional free tiers. Each joins the routing pool automatically when present.
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# Web search. One of these makes Research mode able to actually search.
EXA_API_KEY=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# Repository and deployment reads, install-wide.
NAVI_GITHUB_TOKEN=
NAVI_VERCEL_TOKEN=

# Per-user GitHub sign-in. With these set, each user connects their own account
# and their token is used instead of the install-wide PAT above.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Repository writes. Leave off until the read tools have been watched in
# production. Turning it on changes the requested scope from public_repo to
# repo, so every connected user must re-authorize.
NAVI_GITHUB_ALLOW_WRITES=false

# Sign-in.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
